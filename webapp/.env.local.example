# Copiez ce fichier en .env.local et remplissez les valeurs (jamais commité).

# --- Supabase — Project Settings -> API (obligatoire) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx

# URL publique de cette app (utilisée pour les redirections OAuth en prod).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Agent IA NOVA (optionnel — sans cette clé, /agent affiche "non configuré") ---
# Clé API Anthropic (console.anthropic.com -> API Keys).
ANTHROPIC_API_KEY=
# Optionnel, défaut claude-sonnet-5 si absent.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Stripe (Phase 9 — pas encore de Checkout branché, page Abonnement en lecture seule sans ceci) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Gmail / Google Calendar (Phase 7-8 — pas encore implémenté dans ce dépôt) ---
# Réutilisent le même client OAuth Google Cloud que la connexion (Client ID/Secret
# déjà configurés côté Supabase Auth) ; ces variables serviront quand la connexion
# Gmail dédiée et Calendar seront branchées.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
