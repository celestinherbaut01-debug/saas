# Copiez ce fichier en .env.local et remplissez les valeurs (jamais commité,
# voir .gitignore). En production (Netlify), les mêmes noms de variables sont
# à définir dans Site settings -> Environment variables.

# --- Supabase — Project Settings -> API (obligatoire) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx

# Clé service_role (Project Settings -> API -> service_role, PAS l'anon key)
# — nécessaire UNIQUEMENT pour le sélecteur de plan dev-only de Paramètres
# (public.subscriptions n'a aucune policy RLS d'écriture cliente, volontairement :
# seul un futur webhook Stripe doit y écrire). Jamais préfixée NEXT_PUBLIC_,
# jamais envoyée au navigateur, utilisée uniquement dans une Server Action
# elle-même bloquée par NODE_ENV en production (src/lib/actions/settings.ts).
# NE JAMAIS commiter cette valeur ni la définir sur Netlify/prod.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de cette app : sert de base pour les métadonnées (Open Graph,
# URL canonique). Local : http://localhost:3000. Production : votre URL
# Netlify (https://xxxxx.netlify.app) ou domaine personnalisé une fois prêt.
# Les redirections OAuth, elles, s'adaptent déjà seules à l'origine de la
# requête (voir src/components/google-button.tsx) : rien à changer là.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Agent IA NOVA (optionnel — sans cette clé, /agent affiche "non configuré",
# le reste du site fonctionne normalement) ---
# Clé API Anthropic (console.anthropic.com -> API Keys).
ANTHROPIC_API_KEY=
# Optionnel, défaut claude-sonnet-5 si absent.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Stripe (pas encore branché — les plans/quotas fonctionnent déjà sans,
# voir README "Tester les plans sans payer") ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Gmail / Google Calendar (pas encore implémenté dans ce dépôt) ---
# Réutiliseront un client OAuth Google Cloud dédié (distinct de celui du
# login Supabase) une fois la connexion Gmail/Calendar branchée.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
