# Secrets à définir sur le projet Supabase (jamais commités dans ce repo) :
#   supabase secrets set --env-file .env.local
#
# SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont
# automatiquement injectés dans les Edge Functions par Supabase — inutile de
# les redéfinir ici pour la fonction elle-même. Ils sont listés seulement
# pour le futur frontend (variables publiques VITE_/NEXT_PUBLIC_ à adapter
# selon le framework choisi).

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=xxxxx

# Clé API Google (Cloud Console) avec "Places API (New)" activée.
# Sans cette clé, search-prospects fonctionne quand même : les prospects
# du registre sont retournés mais business_status/website restent "à vérifier"
# au lieu d'être confirmés — jamais de donnée inventée à la place.
GOOGLE_MAPS_API_KEY=xxxxx
